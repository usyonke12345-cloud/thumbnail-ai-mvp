{
  "openapi": "3.1.0",
  "info": {
    "title": "Thumbnail AI MVP",
    "version": "0.3.0",
    "description": "Local SVG layout heuristics, opt-in paid complete PNG generation, and local PNG diagnostics. Complete PNG diagnostics are not a quality or CTR score."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/thumbnails": {
      "post": {
        "operationId": "generateThumbnails",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              },
              "example": {
                "title": "初心者のAI入門",
                "genre": "education"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Three candidates grouped by missing assessment items; overall descending within each group, stable generation order for ties",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                },
                "example": {
                  "apiVersion": "v1",
                  "mode": "demo",
                  "input": {
                    "title": "初心者のAI入門",
                    "genre": "education"
                  },
                  "candidates": [
                    {
                      "id": "d2e2e9ac-3ff3-4d9c-aa4e-564c18ad5b51",
                      "style": "bold",
                      "mimeType": "image/svg+xml",
                      "imageDataUrl": "data:image/svg+xml;base64,",
                      "width": 1280,
                      "height": 720,
                      "metadata": {
                        "textLength": 8,
                        "lineCount": 1,
                        "fontSize": 76,
                        "foreground": "#facc15",
                        "background": "#172554"
                      },
                      "assessment": {
                        "overall": 100,
                        "kind": "layout_heuristic",
                        "version": "0.1.0",
                        "metrics": {
                          "contrast": 100,
                          "brevity": 100,
                          "font": 100
                        },
                        "reasons": [
                          "配色のコントラスト比: 9.6",
                          "タイトル 8文字・1行"
                        ],
                        "limitations": [
                          "画像内容・ジャンル適合は未評価。",
                          "CTR予測や効果保証ではありません。"
                        ]
                      }
                    },
                    {
                      "id": "cdfd1673-17e1-4e35-a2eb-5376286ccc16",
                      "style": "contrast",
                      "mimeType": "image/svg+xml",
                      "imageDataUrl": "data:image/svg+xml;base64,",
                      "width": 1280,
                      "height": 720,
                      "metadata": {
                        "textLength": 8,
                        "lineCount": 1,
                        "fontSize": 76,
                        "foreground": "#ffffff",
                        "background": "#4c1d95"
                      },
                      "assessment": {
                        "overall": 100,
                        "kind": "layout_heuristic",
                        "version": "0.1.0",
                        "metrics": {
                          "contrast": 100,
                          "brevity": 100,
                          "font": 100
                        },
                        "reasons": [
                          "配色のコントラスト比: 11.0",
                          "タイトル 8文字・1行"
                        ],
                        "limitations": [
                          "画像内容・ジャンル適合は未評価。",
                          "CTR予測や効果保証ではありません。"
                        ]
                      }
                    },
                    {
                      "id": "bbebe85c-6208-4cda-9233-8a5240622611",
                      "style": "clean",
                      "mimeType": "image/svg+xml",
                      "imageDataUrl": "data:image/svg+xml;base64,",
                      "width": 1280,
                      "height": 720,
                      "metadata": {
                        "textLength": 8,
                        "lineCount": 1,
                        "fontSize": 64,
                        "foreground": "#0f172a",
                        "background": "#f8fafc"
                      },
                      "assessment": {
                        "overall": 97,
                        "kind": "layout_heuristic",
                        "version": "0.1.0",
                        "metrics": {
                          "contrast": 100,
                          "brevity": 100,
                          "font": 84
                        },
                        "reasons": [
                          "配色のコントラスト比: 17.1",
                          "タイトル 8文字・1行"
                        ],
                        "limitations": [
                          "画像内容・ジャンル適合は未評価。",
                          "CTR予測や効果保証ではありません。"
                        ]
                      }
                    }
                  ],
                  "elapsedMs": 2
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Concurrent, per-process or provider rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Provider network, response or generation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Provider configuration, API key, opt-in or authorization problem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Provider deadline exceeded; billing may have occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/complete-thumbnail": {
      "post": {
        "summary": "Opt-in paid complete thumbnail from one photograph",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "brief",
                  "headline",
                  "imageDataUrl",
                  "consent"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "brief": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "headline": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "imageDataUrl": {
                    "type": "string",
                    "maxLength": 3145728,
                    "description": "1280x720 PNG data URL"
                  },
                  "consent": {
                    "type": "boolean",
                    "const": true
                  },
                  "composition": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "text_left",
                      "text_right",
                      "text_top"
                    ],
                    "default": "auto",
                    "description": "Optional composition intent for the photo edit. Omitted means photo-aware automatic composition. Preservation and exact layout still require visual checking."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One unscored AI complete PNG",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "apiVersion",
                    "mode",
                    "imageDataUrl",
                    "width",
                    "height",
                    "generation_version",
                    "limitations"
                  ],
                  "properties": {
                    "apiVersion": {
                      "const": "1"
                    },
                    "mode": {
                      "const": "ai_complete"
                    },
                    "imageDataUrl": {
                      "type": "string"
                    },
                    "width": {
                      "const": 1536
                    },
                    "height": {
                      "const": 864
                    },
                    "generation_version": {
                      "type": "string"
                    },
                    "limitations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing consent"
          },
          "413": {
            "description": "Input too large"
          },
          "429": {
            "description": "Concurrent request or shared call limit"
          },
          "502": {
            "description": "Provider network or response error"
          },
          "503": {
            "description": "Missing key, disabled paid requests or provider auth"
          },
          "504": {
            "description": "Provider deadline exceeded"
          }
        }
      }
    },
    "/api/v1/complete-diagnostics": {
      "post": {
        "operationId": "diagnoseCompletePng",
        "description": "Local PNG diagnostics, not a quality Assessment. Maximum 4 referenced assets, 16MiB per PNG, 32MiB combined, 45MiB JSON. Integrity/reference errors return 400; corrupt or unsupported PNGs return 200 with status unavailable. Source photos are never treated as text-free backgrounds. Does not call external APIs or consume generation quota.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteDiagnosticRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diagnostics, including explicit unavailable results. No quality score.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteDiagnosticResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid asset input, reference, hash, length or JSON"
          },
          "405": {
            "description": "POST required"
          },
          "413": {
            "description": "JSON exceeds 45MiB"
          },
          "415": {
            "description": "application/json required"
          },
          "500": {
            "description": "Internal failure"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Trimmed, 1–60 Unicode code points; no control characters.",
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "genre": {
            "type": "string",
            "enum": [
              "education",
              "gaming",
              "vlog",
              "other"
            ],
            "default": "other"
          }
        }
      },
      "Metadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "textLength",
          "lineCount",
          "fontSize",
          "foreground",
          "background"
        ],
        "properties": {
          "textLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "lineCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "fontSize": {
            "type": "integer",
            "minimum": 1
          },
          "foreground": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "background": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "generation_version": {
            "type": "string"
          },
          "textLayout": {
            "$ref": "#/components/schemas/TextLayout"
          }
        }
      },
      "Assessment": {
        "type": "object",
        "additionalProperties": false,
        "description": "レイアウトの仮説的な指標（採点0.4.0）。CTR予測や効果保証ではない。未評価の項目は null で、0点とは区別する。",
        "required": [
          "overall",
          "overallMax",
          "coverage",
          "unevaluated",
          "weights",
          "kind",
          "version",
          "metrics",
          "reasons",
          "limitations"
        ],
        "properties": {
          "overall": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "未評価の項目を0点とみなした総合点（下限）。評価済み項目の値×重みの合計を四捨五入。"
          },
          "overallMax": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "未評価の項目を満点とみなした総合点（上限）。すべて評価済みなら overall と同じ。統計的な信頼区間やCTR予測ではない。"
          },
          "coverage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "評価できた項目の重みの合計（%）。"
          },
          "unevaluated": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "contrast",
                "brevity",
                "font",
                "fit"
              ]
            },
            "description": "未評価（metricsがnull）の項目名。contrast, brevity, font, fit の順。すべて評価済みなら空配列。候補のグループ分けに使う。"
          },
          "weights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contrast",
              "brevity",
              "font",
              "fit"
            ],
            "description": "総合点の重み（%、合計100）。仮説で未校正。",
            "properties": {
              "contrast": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "brevity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "font": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "fit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "kind": {
            "const": "layout_heuristic"
          },
          "version": {
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contrast",
              "brevity",
              "font",
              "fit"
            ],
            "properties": {
              "contrast": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100,
                "description": "タイトル文字と背面のコントラスト。タイトルの全行の背面が単色（solid）と確認できた場合だけ評価。"
              },
              "brevity": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100,
                "description": "タイトルの短さ（metadata.textLength）。"
              },
              "font": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100,
                "description": "文字サイズのみ（48px以上で満点＝検証前の仮値）。"
              },
              "fit": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100,
                "description": "配置領域への収まり。タイトルの全行が測定済み（rendered/estimated、寸法あり、正常値）の場合だけ評価。"
              }
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "style",
          "mimeType",
          "imageDataUrl",
          "width",
          "height",
          "metadata",
          "assessment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "style": {
            "enum": [
              "bold",
              "clean",
              "contrast"
            ]
          },
          "mimeType": {
            "const": "image/svg+xml"
          },
          "imageDataUrl": {
            "type": "string",
            "pattern": "^data:image/svg\\+xml;base64,"
          },
          "width": {
            "const": 1280
          },
          "height": {
            "const": 720
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "assessment": {
            "$ref": "#/components/schemas/Assessment"
          }
        }
      },
      "Response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "mode",
          "input",
          "candidates",
          "elapsedMs"
        ],
        "properties": {
          "apiVersion": {
            "const": "v1"
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "ai_background"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/Request"
          },
          "candidates": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "elapsedMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "mode"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "ai_background"
            ]
          },
          "completeGeneration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "keyConfigured",
              "busy",
              "calls",
              "maxCalls"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "keyConfigured": {
                "type": "boolean",
                "description": "Only whether a key is present; never the key itself"
              },
              "busy": {
                "type": "boolean"
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              },
              "maxCalls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        }
      },
      "TextRegion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "width",
          "height",
          "padding"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          },
          "padding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "top",
              "right",
              "bottom",
              "left"
            ],
            "properties": {
              "top": {
                "type": "number",
                "minimum": 0
              },
              "right": {
                "type": "number",
                "minimum": 0
              },
              "bottom": {
                "type": "number",
                "minimum": 0
              },
              "left": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      },
      "TextElement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "lineIndex",
          "text",
          "x",
          "baselineY",
          "topY",
          "width",
          "height",
          "measurement",
          "measurementVersion",
          "fontSize",
          "fontFamily",
          "fontWeight",
          "resolvedFontFamily",
          "foreground",
          "textRegion",
          "textBackdrop"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "title",
              "footer"
            ]
          },
          "lineIndex": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "baselineY": {
            "type": "number"
          },
          "topY": {
            "type": [
              "number",
              "null"
            ]
          },
          "width": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "height": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "measurement": {
            "enum": [
              "estimated",
              "rendered",
              "unknown"
            ]
          },
          "measurementVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "fontSize": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fontFamily": {
            "type": "string"
          },
          "fontWeight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "resolvedFontFamily": {
            "type": [
              "string",
              "null"
            ]
          },
          "foreground": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "textRegion": {
            "$ref": "#/components/schemas/TextRegion"
          },
          "textBackdrop": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "color"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "solid",
                  "image",
                  "unknown"
                ]
              },
              "color": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          },
          "stroke": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "color",
              "width"
            ],
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "width": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "shadow": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "color",
              "blur",
              "offsetX",
              "offsetY"
            ],
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
