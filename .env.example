# Optional: node --env-file=.env backend/server.mjs
PORT=3000
GENERATION_PROVIDER=mock
# To use paid AI backgrounds, set provider=openai and enabled=true.
# Enter the key only in local .env, never in Git or chat.
OPENAI_API_KEY=
OPENAI_IMAGE_ENABLED=false
# Hard call-count limit per process, NOT a dollar billing cap. Resets on restart.
OPENAI_MAX_CALLS=10
OPENAI_TIMEOUT_MS=120000
