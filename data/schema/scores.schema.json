{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Score of one candidate style in a 3-candidate set (for B5 agreement; not CTR)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "style",
    "overall",
    "scoring_version"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "description": "preferences.csv の candidate_id と同じ、3案の組のID"
    },
    "style": {
      "enum": [
        "bold",
        "contrast",
        "clean"
      ]
    },
    "overall": {
      "type": "string",
      "pattern": "^(100|[1-9]?[0-9])$"
    },
    "scoring_version": {
      "type": "string",
      "minLength": 1
    },
    "unevaluated": {
      "type": "string",
      "pattern": "^$|^(contrast|brevity|font|fit)(\\|(contrast|brevity|font|fit))*$",
      "description": "任意。採点0.4.0以降の未評価項目を | でつないだもの（例: contrast|fit）。全項目評価済みなら空。未評価の組み合わせが違う組は順位比較しない"
    }
  }
}
